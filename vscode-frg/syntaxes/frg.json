{
  "name": "frg",
  "scopeName": "source.frg",
  "fileTypes": ["frg"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#builtin" },
    { "include": "#numbers" },
    { "include": "#identifiers" },
    { "include": "#operators" },
    { "include": "#delimiters" },
    { "include": "#brackets" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line",
          "match": "^//.*"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double",
          "match": "\"([^\"])*\""
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control",
          "match": "\\b(if|else|return|while)\\b"
        },
        {
          "name": "keyword",
          "match": "\\bstruct\\b"
        },
        {
          "name": "constant.language",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "support.type.primitive",
          "match": "\\b(void|int|float|str|bool)\\b"
        },
        {
          "name": "support.type.collection",
          "match": "\\b(vec|arr|array|list|map|obj|hashmap|dict|dictionary)\\b"
        }
      ]
    },
    "builtin": {
      "patterns": [
        {
          "name": "support.function",
          "match": "@[a-z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float",
          "match": "\\d+\\.\\d+"
        },
        {
          "name": "constant.numeric.integer",
          "match": "\\d+"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.function",
          "match": "[a-z_][a-zA-Z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "entity.name.type",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "variable.other",
          "match": "[a-z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment",
          "match": "([+\\-*/%])?="
        },
        {
          "name": "keyword.operator.comparison",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arithmetic",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.bitwise",
          "match": "&"
        },
        {
          "name": "keyword.operator.range",
          "match": "(\\.\\.=?|\\.\\.\\+)"
        },
        {
          "name": "keyword.operator.dereference",
          "match": "\\.\\*"
        }
      ]
    },
    "delimiters": {
      "patterns": [
        {
          "name": "punctuation.separator",
          "match": "[,.:]"
        },
        {
          "name": "punctuation.accessor",
          "match": "\\.(?![a-zA-Z])"
        }
      ]
    },
    "brackets": {
      "patterns": [
        {
          "name": "punctuation.bracket",
          "match": "[\\(\\)\\[\\]{}]"
        }
      ]
    }
  }
}
